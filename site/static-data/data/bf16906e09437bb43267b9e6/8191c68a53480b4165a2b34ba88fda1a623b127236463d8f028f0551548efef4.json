  "description": "\u7D42\u672B\u5730\u5DE5\u696D\u88FD\u9020\u7684\u7279\u5225\u88DD\u5099\u4E4B\u4E00\u3002\u7130\u5F62\u528D\u642D\u914D\u7684\u4EA4\u932F\u5F0F\u6E90\u77F3\u7DDA\u8DEF\u80FD\u63D0\u9AD8\u57FA\u8CEA\u6548\u7387\u3002\u9748\u611F\u4F86\u65BC\u89C0\u6E2C\u5230\u7684\u5854\u7F85\u65AF\u73FE\u8C61\u3002",
  "lore": "\u5979\u6BD4\u5176\u4ED6\u4EBA\u770B\u5F97\u66F4\u6E05\u695A\u4E00\u4E9B\u3002\n\u8DE8\u904E\u90A3\u6247\u9580\u7684\u65C5\u9014\u6BD4\u5979\u60F3\u50CF\u7684\u8981\u4FB7\u4FC3\u4E00\u9EDE\u3002\u4E00\u4E9B\u5E7B\u5F71\uFF0C\u4E00\u4E9B\u8FF7\u96E2\u7684\u8272\u5F69\uFF0C\u808C\u819A\u4E0A\u4E00\u9583\u800C\u904E\u7684\u4E0D\u5207\u5BE6\u969B\u7684\u89F8\u611F\uFF0C\u9084\u6709\u77ED\u66AB\u7684\u6688\u7729\u3001\u4F4E\u8A9E\u3001\u95DC\u65BC\u904E\u5F80\u7684\u788E\u7247\uFF0C\u7DCA\u63A5\u8457\uFF0C\u662F\u56B4\u5BD2\u3002\u5F9E\u51AC\u5929\u56DE\u5230\u51AC\u5929\u7684\u56B4\u5BD2\uFF0C\u5F88\u6709\u771F\u5BE6\u611F\u3002\n\u5979\u7ACB\u523B\u8A62\u554F\u8EAB\u908A\u7684\u6BCF\u4E00\u500B\u4EBA\uFF0C\u6BCF\u4E00\u500B\u4EBA\u90FD\u544A\u8A34\u4E86\u5979\u4E0D\u540C\u7684\u7B54\u6848\u3002\u6709\u4E9B\u4EBA\u89BA\u5F97\u773C\u775B\u4E00\u9589\u4E00\u775C\u5C31\u6C92\u4E8B\u4E86\uFF0C\u6709\u4E9B\u4EBA\u5247\u6C23\u5598\u5401\u5401\u5730\u8868\u793A\u81EA\u5DF1\u5F77\u5F7F\u975C\u6EEF\u4E86\u597D\u5E7E\u5929\u7684\u6642\u9593\u3002\n\u5979\u5F88\u597D\u5947\u81EA\u5DF1\u6240\u770B\u898B\u7684\u6771\u897F\u662F\u5426\u6709\u4EC0\u9EBC\u610F\u7FA9\u2014\u2014\u597D\u5947\u662F\u5979\u7684\u5929\u6027\u3002\u5979\u82B1\u4E86\u5E7E\u500B\u5C0F\u6642\u5728\u8166\u6D77\u88E1\u9328\u5B9A\u90A3\u4E9B\u8272\u584A\u3001\u7DDA\u689D\u548C\u4E0D\u898F\u5F8B\u7684\u97F3\u8272\u3002\u4F46\u5B83\u5011\u5C31\u50CF\u6625\u5929\u5C0F\u61A9\u6642\u7684\u5922\u5883\u90A3\u6A23\u96E3\u4EE5\u6349\u6478\uFF0C\u7F3A\u4E4F\u542B\u7FA9\u3002\n\u76F4\u5230\u5979\u5728\u4E00\u7247\u65D6\u65CE\u7684\u5149\u7DDA\u4E2D\u770B\u5411\u4E86\u6C92\u6709\u963B\u9694\u5C64\u7684\u661F\u7A7A\u3002\n\u5854\u7F85\u65AF\u3002\n\n\u6642\u9593\u4E26\u6C92\u6709\u628A\u5915\u967D\u5E36\u5230\u5854\u885B\u4E8C\u7684\u6975\u9EDE\uFF0C\u5DE8\u5927\u7684\u661F\u7403\u5360\u64DA\u4E86\u6240\u6709\u4EBA\u7684\u8996\u91CE\uFF0C\u50CF\u662F\u67D0\u7A2E\u9060\u8D85\u5DEB\u738B\u7684\u5DEB\u8853\u90A3\u6A23\u6B7B\u6B7B\u6390\u4F4F\u4E86\u5979\u7684\u9748\u9B42\u3002\u5979\u7121\u6CD5\u79FB\u958B\u76EE\u5149\uFF0C\u5979\u5F9E\u672A\u60F3\u904E\u77E5\u8B58\u548C\u8CA1\u5BCC\u4E4B\u5916\uFF0C\u81EA\u7136\u7684\u666F\u8272\u6703\u5982\u6B64\u5438\u5F15\u5979\u2014\u2014\u5982\u679C\u5B87\u5B99\u9019\u500B\u5D84\u65B0\u7684\u8996\u89D2\u80FD\u6B78\u985E\u70BA\u81EA\u7136\u7684\u8A71\uFF0C\u5979\u4E0D\u662F\u5F88\u78BA\u5B9A\u3002\n\u5979\u7AEF\u8A73\u8457\u5854\u7F85\u65AF\u3002\u9019\u662F\u4E00\u9846\u5E7E\u4E4E\u975C\u6B62\u7684\u5927\u661F\u7403\uFF0C\u6234\u4E0A\u4E86\u53EF\u611B\u7684\u74B0\u5F62\u7D72\u5E36\u3002\u5979\u53EA\u5728\u5B38\u5B38\u7684\u7E2B\u7D09\u6A5F\u4E0A\u770B\u904E\u9019\u7A2E\u53EF\u611B\u7684\u7D72\u5E36\uFF0C\u50CF\u662F\u82B1\u74E3\u7684\u908A\u7DE3\u3002\u5F88\u5FEB\uFF0C\u5979\u5C31\u767C\u73FE\u975C\u6B62\u53EA\u662F\u5854\u7F85\u65AF\u53EF\u611B\u7684\u5C0F\u4F0E\u5006\uFF0C\u9019\u9846\u661F\u7403\u4F3C\u4E4E\u6B63\u5728\u4E0D\u8D77\u773C\u5730\u904B\u52D5\u8457\u3002\u8868\u9762\u7684\u5149\u6FA4\u5728\u6D41\u52D5\uFF0C\u5979\u80FD\u807D\u898B\u98A8\u8072\u3002\n\u4F46\u5F88\u5FEB\uFF0C\u9019\u4E00\u5207\u90FD\u6D88\u5931\u4E86\u3002\u5854\u7F85\u65AF\u53C8\u8B8A\u56DE\u4E86\u90A3\u500B\u4E00\u52D5\u4E0D\u52D5\u7684\u5DE8\u7269\u3002\u5979\u611F\u5230\u5FC3\u8DF3\u52A0\u901F\uFF0C\u4E00\u4E9B\u4E0D\u898F\u5F8B\u7684\u60F3\u6CD5\u6E67\u73FE\u5728\u8166\u6D77\u88E1\u3002\u5F9E\u5152\u6642\u7B2C\u4E00\u4EFD\u6CD5\u8853\u8AB2\u7B54\u5377\u958B\u59CB\uFF0C\u4E00\u76F4\u5230\u53BB\u5E74\u5728\u9AD8\u5854\u4E0A\u5B8C\u6210\u7684\u9032\u53D6\u7814\u7A76\u3002\u5979\u770B\u5230\u4E86\u7236\u6BCD\u7684\u9762\u5B54\uFF0C\u770B\u5230\u4E86\u8001\u5E2B\uFF0C\u770B\u5230\u4E86\u6B98\u57A3\u65B7\u58C1\u88E1\u4F38\u51FA\u7684\u4E00\u96BB\u624B\uFF0C\u770B\u5230\u4E86\u6DF1\u9060\u7684\u6D41\u6C99\u3002\u5979\u5728\u6F06\u9ED1\u7684\u6D77\u5CB8\u908A\u7AD9\u7A69\u8173\u8DDF\uFF0C\u6700\u5F8C\u662F\u81EA\u5DF1\u7684\u81C9\u9F90\uFF0C\u5152\u6642\u6240\u898