  "lore": "\u300C\u56E0\u6B64\u6211\u8A5B\u5492\u4F60\u5011\uFF0C\u4F60\u5011\u7684\u8840\u6DB2\u5C07\u5728\u8352\u856A\u7684\u5927\u5730\u4E4B\u4E0A\u6D41\u6DCC\uFF0C\u532F\u805A\u6210\u6C60\uFF0C\u4F60\u5011\u7684\u65CF\u4EBA\uFF0C\u4F60\u5011\u7684\u6240\u611B\uFF0C\u5C07\u65BC\u8840\u6C60\u4E2D\u6EBA\u6583\u3002\u300D\n\u53E4\u820A\u7B46\u8A18\u4E0A\u5BEB\u8457\u9019\u6A23\u7684\u8A71\uFF0C\u65BC\u662F\u4ED6\u60F3\u4E86\u60F3\uFF0C\u62FF\u51FA\u4E86\u81EA\u5DF1\u7684\u4FE1\u7D19\uFF0C\u958B\u59CB\u66F8\u5BEB\u2014\u2014\n\u300C\u5F88\u5C11\u6709\u4EBA\u6E05\u695A\u88C2\u5730\u8005\u70BA\u4EC0\u9EBC\u8981\u8FFD\u6BBA\u88C2\u5730\u8005\uFF0C\u7562\u7ADF\u4ED6\u5011\u66FE\u662F\u4E00\u500B\u9084\u7B97\u5718\u7D50\u7684\u6574\u9AD4\uFF0C\u66FE\u53D7\u540C\u4E00\u500B\u9996\u9818\u6307\u63EE\u2026\u2026\u5C31\u7B97\u4ED6\u5011\u5F8C\u7E8C\u5206\u88C2\u4E86\uFF0C\u4E5F\u5F88\u96E3\u7522\u751F\u5982\u6B64\u6FC0\u70C8\u7684\u77DB\u76FE\u2026\u2026\u9019\u672C\u7B46\u8A18\u4E2D\u8A18\u9304\u7684\u523B\u9AA8\u4EC7\u6068\uFF0C\u4EE5\u53CA\u4F5C\u8005\u6293\u6355\u5230\u90A3\u4E9B\u96F6\u6563\u88C2\u5730\u8005\u5F8C\uFF0C\u5C0D\u4ED6\u5011\u65BD\u5C55\u51FA\u7684\u6B98\u9177\u624B\u6BB5\u2026\u2026\u4F3C\u4E4E\u53EA\u6709\u300E\u6050\u6016\u300F\u5169\u500B\u5B57\u80FD\u5F62\u5BB9\u3002\u300D\n\u4ED6\u7E7C\u7E8C\u601D\u8003\u8457\uFF0C\u4F46\u597D\u50CF\u5C0D\u7D50\u8AD6\u5F88\u4E0D\u6EFF\u610F\uFF0C\u65BC\u662F\u7B46\u5C16\u8207\u7D19\u5F35\u7684\u6469\u64E6\u8072\u7E7C\u7E8C\u50B3\u51FA\u3002\n\u300C\u6211\u8A66\u5716\u5728\u9019\u4E9B\u6587\u5B57\u4E2D\u5C0B\u627E\u5230\u4E00\u4E9B\u300E\u5171\u6027\u300F\uFF0C\u6BD4\u5982\u88C2\u5730\u8005\u5011\u662F\u5426\u771F\u7684\u72AF\u4E0B\u904E\u4EC0\u9EBC\u6703\u8B93\u4EBA\u89BA\u5F97\u300E\u898B\u4E4B\u5FC5\u6BBA\u300F\u7684\u7F6A\u5B7D\uFF0C\u53C8\u6216\u8005\u4ED6\u5011\u662F\u5426\u6709\u4EC0\u9EBC\u6301\u7E8C\u81F3\u4ECA\u7684\u90AA\u60E1\u8A08\u5283\u2026\u2026\u7121\u8AD6\u662F\u51FA\u65BC\u5DE5\u4F5C\u9084\u662F\u611B\