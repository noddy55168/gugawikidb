  "lore": "\u6211\u5011\u5728\u4E00\u5EA7\u7121\u540D\u7684\u5C71\u5CF0\u4E0A\u767C\u73FE\u4E86\u9019\u584A\u7926\u77F3\u3002\u70BA\u4E86\u5B83\uFF0C\u4F60\u7238\u7238\u4E09\u6B21\u6316\u6398\u5230\u529B\u7AED\u3002\u4F46\u8ACB\u4E0D\u8981\u64D4\u5FC3\uFF0C\u4ED6\u5F88\u597D\u3002\u4ED6\u6700\u8FD1\u6709\u9EDE\u7F3A\u4E4F\u904B\u52D5\u3002\u6211\u5011\u770B\u4E86\u4F60\u7684\u756B\uFF0C\u5F88\u9AD8\u8208\u4F60\u80FD\u756B\u51FA\u9019\u9EBC\u6F02\u4EAE\u7684\u65BD\u8853\u55AE\u5143\u85CD\u5716\u3002\u4F60\u770B\uFF0C\u9019\u584A\u767D\u8272\u7684\u91D1\u5C6C\u662F\u4E0D\u662F\u525B\u597D\u9069\u5408\u7576\u5B83\u7684\u773C\u775B\uFF1F\u6211\u5011\u5F88\u5FEB\u5C31\u6703\u56DE\u5E1D\u6C5F\u865F\u3002\u5E0C\u671B\u4F60\u4E00\u5207\u90FD\u597D\u3002\n\u2026\u2026\u2026\u2026\n\u6211\u5011\u5728\u74B0\u5854\u5546\u6703\u767C\u73FE\u4E86\u4E00\u500B\u5929\u624D\u822C\u7684\u8A2D\u8A08\u5E2B\uFF0C\u7136\u5F8C\u5F9E\u96F7\u795E\u5DE5\u696D\u624B\u88E1\u9AD8\u50F9\u8CB7\u4E0B\u4E86\u4ED6\u7684\u982D\u865F\u8A2D\u8A08\uFF0C\u6253\u7B97\u7576\u4F5C\u4F60\u7684\u751F\u65E5\u79AE\u7269\u3002\u62B1\u6B49\uFF0C\u672C\u4F86\u662F\u60F3\u8981\u7D66\u4F60\u4E00\u500B\u9A5A\u559C\u7684\uFF0C\u4F46\u56E0\u70BA\u7AF6\u62CD\u82B1\u6389\u4E86\u6211\u5011\u6240\u6709\u7684\u9322\uFF0C\u6240\u4EE5\u6211\u5011\u6372\u5165\u4E86\u4E00\u9EDE\u9EBB\u7169\u88E1\u3002\u56DE\u5E1D\u6C5F\u865F\u7684\u65E5\u5B50\u6703\u7A0D\u5FAE\u6709\u9EDE\u5EF6\u8AA4\uFF0C\u4E0D\u904E\u4E00\u5B9A\u8D95\u5728\u4F60\u7684\u751F\u65E5\u4E4B\u524D\u3002\u5E0C\u671B\u4F60\u4E00\u5207\u90FD\u597D\u3002\u4E5F\u66FF\u7238\u7238\u5ABD\u5ABD\u5411\u4F69\u9E97\u5361\u76E3\u7763\u554F\u8072\u597D\u3002\n\u2026\u2026\u2026\u2026\n\u6211\u5011\u9047\u5230\u4E86\u8B1D\u82D7\u53D4\u53D4\uFF0C\u4E5F\u5728\u56DB\u865F\u8C37\u5730\u770B\u5230\u4E86\u4F60\u8A2D\u8A08\u7684\u624B\u9283\u3002\u6211\u5011\u975E\u5E38\u611F\u52D5\u3002\u4F60\u7238\u7238\u600E\u9EBC\u52F8\u90FD\u4E0D\u807D\uFF0C\u6C92\u8D70\u6D41\u7A0B\uFF0C\u5077\u5077\