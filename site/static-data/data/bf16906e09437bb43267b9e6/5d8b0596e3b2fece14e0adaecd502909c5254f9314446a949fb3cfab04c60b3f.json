  "lore": "\u8036\u723E\u4EC0\u53C8\u5728\u4E0B\u96EA\uFF0C\u4ECA\u65E5\u7121\u98A8\uFF0C\u96EA\u82B1\u5782\u76F4\u843D\u5165\u58B3\u5893\u9593\u3002\n\u592A\u51B7\u4E86\uFF0C\u7AD9\u5728\u58B3\u5893\u908A\u7684\u4FE1\u4F7F\u60F3\u8457\u3002\u4ED6\u6253\u4E86\u500B\u51B7\u986B\uFF0C\u63E1\u7DCA\u4E86\u624B\u88E1\u7684\u71B1\u8336\u3002\n\u5012\u662F\u90A3\u4F4D\u5148\u751F\u2026\u2026\u4F3C\u4E4E\u5F9E\u4F86\u4E0D\u6015\u51B7\uFF0C\u4FE1\u4F7F\u5982\u6B64\u60F3\u8457\u3002\u4ED6\u8209\u76EE\u770B\u53BB\uFF0C\u5C71\u9593\u9727\u6C23\u7030\u6F2B\uFF0C\u4F46\u4ECD\u80FD\u770B\u898B\u4E00\u7E37\u91D1\u8272\u5FAE\u5149\uFF0C\u4ED6\u7787\u8D77\u773C\u775B\uFF0C\u8FA8\u8A8D\u51FA\u90A3\u662F\u6536\u85CF\u5BB6\u5148\u751F\u4ECA\u5929\u5E36\u4F86\u7684\u65BD\u8853\u55AE\u5143\uFF0C\u770B\u8D77\u4F86\u4E5F\u662F\u4E00\u500B\u8001\u7269\u4EF6\u3002\n\u81EA\u4ED6\u63A5\u4E0B\u9019\u4EFD\u59D4\u8A17\u4EE5\u4F86\uFF0C\u5DF2\u7D93\u904E\u4E86\u4E03\u5E74\u3002\u4ED6\u8A18\u4E0D\u6E05\u81EA\u5DF1\u7A76\u7ADF\u4E0A\u5C71\u4E86\u591A\u5C11\u6B21\uFF0C\u53C8\u70BA\u5C0D\u65B9\u9001\u51FA\u4E86\u591A\u5C11\u500B\u5305\u88F9\u3002\n\u6BCF\u500B\u5305\u88F9\u90FD\u5F88\u91CD\u8981\uFF0C\u6536\u85CF\u5BB6\u5148\u751F\u5982\u6B64\u544A\u8A34\u4ED6\uFF0C\u56E0\u70BA\u9019\u662F\u6B7B\u8005\u5BB6\u5C6C\u80FD\u6536\u5230\u7684\u6700\u5F8C\u4E00\u4EF6\u907A\u7269\uFF0C\u8981\u4FDD\u8B49\u9001\u9054\u3002\n\u6B7B\u8005\uFF0C\u6536\u85CF\u5BB6\u5148\u751F\u5982\u6B64\u7A31\u547C\u9019\u4E9B\u57CB\u846C\u5728\u96EA\u5C71\u4E2D\u7684\u4EBA\uFF0C\u758F\u96E2\u800C\u51B7\u975C\u3002\u4F46\u7576\u4ED6\u8D70\u5165\u58B3\u5893\u9593\uFF0C\u537B\u53C8\u7121\u6BD4\u5C08\u6CE8\uFF0C\u9084\u6703\u8AAA\u8D77\u6709\u95DC\u4ED6\u5011\u7684\u6545\u4E8B\uFF0C\u50CF\u662F\u7121\u6BD4\u719F\u6089\u90A3\u4E9B\u9577\u7720\u7684\u53EF\u6190\u4EBA\u3002\n\u2014\u2014\u7E8F\u7E5E\u4E86\u4E09\u6BB5\u5F69\u8272\u5E03\u689D\u7684\u77F3\u5806\u4E0B\uFF0C\u57CB\u8457\u4F4D\u5E74\u8F15\u6D3B\u6F51\u7684\u4F69\u6D1B\uFF0C\u9084\u6C92\u5230\u5317\u6975\u9EDE\u5C31\u53BB\u4E16\u4E86\u3002\n\u2014\u2014\u6771\u5317\u89D2\u90A3\u500B\u9ED1\u8272\u77F3\u5806\u88E1\uFF0C\u5247\u7761\u8457\u4E00\u540D\u529B\u5927\u7121\u7AAE\u7684\u8C50\u8E44\u6230\u58EB\uFF0C\u80CC\u8457\u6700\u91CD\u7684\u7269\u8CC7\u4E5F\u80FD\u5065\u6B65\u5982\u98DB\u3002\n\u2014\u2014\u9019\u500B\u7070\u8272\u77F3\u5806\uFF0C\u4E0A\u9762\u7684\u5F69\u5E36\u90FD\u892A\u8272\u4E86\uFF0C\u9019\u88E1\u57CB\u8457\u2026\u2026\n\u57CB\u8457\u8AB0\u5462\uFF1F\u4FE1\u4F7F\u4E0D\u8A18\u5F97\u4E86\uFF0C\u5927\u6982\u53EA\u6709\u6536\u85CF\u5BB6\u5148\u751F\u624D\u80FD\u8A18\u4F4F\u6240\u6709\u4EBA\u7684\u6545\u4E8B\u3002\n\u90A3\u4F4D\u5148\u751F\u4F3C\u4E4E\u8A8D\u8B58\u9019\u88E1\u7684\u6BCF\u4E00\u500B\u4EBA\uFF0C\u4FE1\u4F7F\u60F3\u8457\uFF0C\u9019\u9084\u771F\u662F\u4EF6\u602A\u4E8B\u3002\u7562\u7ADF\u6709\u4E9B\u58B3\u5893\u770B\u8D77\u4F86\u53EF\u4E0D\u662F\u5341\u5E74\u524D\u5EFA\u9020\u7684\u3002\u6309\u8036\u723E\u4EC0\u7684\u50B3\u7D71\uFF0C\u77F3\u5806\u8D8A\u9AD8\uFF0C\u58B3\u5893\u7684\u5E74\u6B72\u8D8A\u9577\u3002\u4FE1\u4F7F\u6562\u6253\u8CED\uFF0C\u90A3\u500B\u6700\u5927\u7684\u77F3\u5806\u770B\u8D77\u4F86\u8D77\u78BC\u6709\u500B\u4E94\u5341\u5E74\u6B77\u53F2\u3002\n\u6216\u8A31\u6536\u85CF\u5BB6\u5148\u751F\u4E0D\u53EA\u7D93\u6B77\u904E\u6975\u9EDE\u9060\u5F81\uFF0C\u5C0D\u65B9\u7684\u6545\u4E8B\uFF0C\u6BD4\u4ED6\u60F3\u50CF\u7684\u9084\u8981\u6F2B\u9577\u3002\n\u300C\u5929\u6C23\u5F88\u51B7\u5427\uFF0C\u52DE\u7169\u4F60\u5728\u9019\u7B49\u4E86\u90A3\u9EBC\u4E45\u3002\u300D\u4E0D\u77E5\u4F55\u6642\uFF0C\u6536\u85CF\u5BB6\u5148\u751F\u8D70\u904E\u4F86\uFF0C\u6253\u65B7\u4E86\u4FE1\u4F7F\u7684\u80E1\u601D\u4E82\u60F3\u3002\n\u4FE1\u4F7F\u9023\u5FD9\u6416\u982D\uFF0C\u628A\u65E9\u5DF2\u6E96\u5099\u597D\u7684\u71B1\u8336\u905E\u7D66\u5C0D\u65B9\uFF1A\u300C\u5148\u751F\uFF0C\u559D\u9EDE\u8336\u9A45\u5BD2\u5427\u3002\u5C0D\u4E86\uFF0C\u4ECA\u5929\u7684\u5305\u88F9\u662F\u54EA\u500B\uFF1F\u4E0B\u5348\u6050\u6015\u662F\u6703\u6709\u66B4\u98A8\u96EA\uFF0C\u8981\u662F\u7E9C\u8ECA\u505C\u904B\u5C31\u9EBB\u7169\u4E86\uFF0C\u6211\u5F97\u5FEB\u9EDE\u5E6B\u60A8\u9001\u51FA\u53BB\u3002\u300D\n\u300C\u53EA\u6709\u9019\u500B\u3002\u300D\u6536\u85CF\u5BB6\u5148\u751F\u62FF\u8D77\u4E86\u90A3\u4EF6\u9583\u720D\u8457\u5FAE\u5149\u7684\u65BD\u8853\u55AE\u5143\uFF0C\u300C\u9664\u4E86\u5B83\u4E4B\u5916\uFF0C\u6240\u6709\u907A\u7269\u90FD\u5DF2\u5BC4\u51FA\u3002\u4EE5\u5F8C\u4F60\u4E5F\u4E0D\u7528\u4E0A\u5C71\u5E6B\u6211\u9001\u5305\u88F9\u4E86\u3002\u62FF\u8457\u9019\u4E9B\u91D1\u7968\uFF0C\u4EE5\u5F8C\u4E0D\u8981\u518D\u98A8\u5439\u65E5\u66EC\uFF0C\u5C31\u5728\u5C71\u4E0B\u505A\u9EDE\u5C0F\u751F\u610F\u5427\u3002\u300D\n\u4FE1\u4F7F\u63E1\u8457\u4E00\u758A\u539A\u539A\u7684\u91D1\u7968\u3002\u9019\u4EFD\u4FE1\u4F7F\u59D4\u8A17\u6301\u7E8C\u4E86\u4E03\u5E74\uFF0C\u73FE\u5728\u7D42\u65BC\u7D50\u675F\u3002\u53EF\u5373\u4FBF\u76F8\u8B58\u4E03\u5E74\uFF0C\u4ED6\u537B\u4F9D\u7136\u4E0D\u77E5\u9053\u773C\u524D\u9019\u4F4D\u5148\u751F\u53EB\u4EC0\u9EBC\u540D\u5B57\uFF0C\u5F9E\u54EA\u88E1\u4F86\uFF0C\u53C8\u8981\u5230\u54EA\u88E1\u53BB\u3002\n\u4ED6\u8E8A\u8E87\u4E86\u4E00\u4E0B\uFF0C\u6536\u85CF\u5BB6\u5148\u751F\u4F3C\u4E4E\u770B\u51FA\u4ED6\u7684\u60F3\u6CD5\uFF0C\u4FBF\u958B\u53E3\u9053\uFF1A\u300C\u662F\u60F3\u554F\u6211\u9EDE\u4EC0\u9EBC\u55CE\uFF1F\u300D\n\u4FE1\u4F7F\u4E0D\u597D\u610F\u601D\u5730\u6293\u4E86\u6293\u982D\uFF1A\u300C\u679C\u7136\u88AB\u60A8\u770B\u51FA\u4F86\u4E86\u3002\u6211\u5C31\u662F\u6709\u9EDE\u597D\u5947\uFF0C\u9019\u9EBC\u591A\u5E74\uFF0C\u60A8\u8DDF\u6211\u8AAA\u4E86\u90A3\u9EBC\u591A\u904E\u53BB\u7684\u6545\u4E8B\uFF0C\u4F46\u90A3\u90FD\u662F\u5225\u4EBA\u7684\u4E8B\u3002\u90A3\u60A8\u5462\uFF1F\u60A8\u4E5F\u53C3\u52A0\u904E\u90A3\u9EBC\u591A\u6230\u5F79\uFF0C\u60A8\u5C31\u6C92\u6709\u81EA\u5DF1\u7684\u56DE\u61B6\u55CE\uFF1F\u300D\n\u6536\u85CF\u5BB6\u5148\u751F\u6C89\u9ED8\u4E86\u3002\n\u66B4\u98A8\u96EA\u4F3C\u4E4E\u8981\u4F86\u4E86\uFF0C\u98A8\u8D8A\u4F86\u8D8A\u5927\uFF0