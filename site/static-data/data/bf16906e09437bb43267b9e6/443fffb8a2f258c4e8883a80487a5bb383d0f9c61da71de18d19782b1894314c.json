  "lore": "\u5979\u6E05\u6668\u4F86\u5230\u5893\u5712\u79B1\u544A\uFF0C\u4E2D\u5348\u96E2\u958B\uFF0C\u4E0B\u5348\u5F9E\u4E8B\u4E00\u4E9B\u793E\u5340\u52DE\u52D5\u670D\u52D9\uFF0C\u508D\u665A\u518D\u56DE\u5230\u5893\u5712\uFF0C\u7136\u5F8C\u6DF1\u591C\u56DE\u5BB6\u3002\u6211\u8DDF\u8E64\u904E\uFF0C\u5979\u7684\u5BB6\u5C31\u5728\u5893\u5712\u6771\u5357\u65B9\u5411\uFF0C\u6700\u591A\u4E00\u516C\u91CC\u3002\u548C\u5927\u90E8\u5206\u773E\u751F\u9577\u5730\u7684\u904A\u4EBA\u4E00\u6A23\uFF0C\u5373\u4F7F\u5728\u8352\u90CA\u91CE\u5DBA\uFF0C\u5979\u4E5F\u6709\u8FA6\u6CD5\u6021\u7136\u81EA\u8655\u3002\n\u5979\u5012\u662F\u4E0D\u7274\u89F8\u548C\u5916\u4EBA\u6253\u4EA4\u9053\uFF0C\u807D\u8AAA\u6709\u5DE5\u5718\u7684\u4EBA\u9084\u548C\u5979\u63A5\u89F8\u904E\uFF0C\u5927\u591A\u662F\u7269\u8CC7\u4EA4\u6613\u4E0A\u7684\u4E8B\u60C5\u3002\n\u5979\u770B\u8D77\u4F86\u4E00\u9EDE\u90FD\u4E0D\u5371\u96AA\uFF0C\u5E74\u8F15\u3001\u6EAB\u67D4\uFF0C\u751A\u81F3\u6709\u4E00\u9EDE\u7F9E\u602F\u3002\n\u4F46\u662F\uFF0C\u4F60\u77E5\u9053\u5427\uFF1F\u96E2\u9019\u88E1\u6700\u8FD1\u7684\u805A\u843D\u5927\u6982\u6709\u4E0A\u767E\u516C\u91CC\uFF0C\u53EF\u662F\u9019\u88E1\u6709\u4E00\u500B\u5893\u5712\uFF0C\u800C\u4E14\u53EA\u6709\u4E00\u500B\u5B88\u5893\u4EBA\uFF01\n\u6211\u78BA\u8A8D\u904E\uFF0C\u90A3\u5893\u5712\u88E1\u7684\u6240\u6709\u4EBA\u90FD\u548C\u5979\u6C92\u6709\u95DC\u4FC2\u3002\u5927\u90E8\u5206\u662F\u4E00\u4E9B\u56E0\u70BA\u4FB5\u8755\u4E8B\u6545\u6216\u5929\u4F7F\u8972\u64CA\u547D\u55AA\u8352\u91CE\u7684\u8DEF\u4EBA\u3002\u800C\u4E14\u5148\u4E0D\u63D0\u7121\u540D\u7891\uFF0C\u6709\u540D\u5B57\u7684\u6211\u90FD\u53BB\u67E5\u4E86\uFF0C\u90FD\u662F\u9019\u5E7E\u5E74\u7684\u5931\u8E64\u4EBA\u53E3\u3002\n\u5225\u8AAA\u958B\u8ECA\u8DEF\u904E\u7684\u5DE5\u4EBA\u5011\uFF0C\u6211\u73FE\u5728\u90FD\u958B\u59CB\u5BB3\u6015\u4E86\u3002\n\u9019\u5DE5\u4F5C\u6211\u6700\u591A\u518D\u505A\u4E00\u9031\u3002\u5230\u6642\u5019\u628A\u6240\u6709\u7167\u7247\u548C\u9304\u5F71\u90FD\u7D66\u4F60\uFF0C\u6