  "lore": "\u5C0A\u656C\u7684\u5B8F\u5C71\u79D1\u5B78\u9662\u5929\u5E2B\uFF1A\n\u4F60\u5011\u597D\u3002\n\u9019\u5C01\u4FE1\uFF0C\u6211\u5DF2\u601D\u616E\u8A31\u4E45\uFF0C\u5BE6\u5728\u4E0D\u77E5\u9053\u8A72\u5BC4\u7D66\u8AB0\u3002\u53EA\u80FD\u62DC\u8A17\u4E00\u4F4D\u5728\u8CB4\u9662\u7684\u53CB\u4EBA\uFF0C\u4EE3\u7B46\u5BEB\u4E0B\u9019\u5C01\u611F\u8B1D\u4FE1\uFF0C\u4E26\u96A8\u4FE1\u9644\u4E0A\u4E00\u9762\u6211\u5C08\u7A0B\u8A02\u88FD\u7684\u9326\u65D7\uFF0C\u4EE5\u53CA\u4E00\u7BB1\u8584\u79AE\u3002\u61C7\u8ACB\u5404\u4F4D\u80FD\u5C07\u9019\u4EFD\u8B1D\u610F\uFF0C\u8F49\u4EA4\u7D66\u90A3\u4E09\u4F4D\u66FE\u6551\u6211\u4E00\u547D\u7684\u6069\u4EBA\u3002\n\u6211\u662F\u74B0\u5854\u5546\u6703\u7684\u4E00\u540D\u884C\u5546\uFF0C\u5E38\u5E74\u5954\u8D70\u65BC\u5404\u5730\u3002\u524D\u6BB5\u6642\u9593\uFF0C\u6211\u5728\u5408\u91D1\u863F\u8514\u57CE\u9644\u8FD1\u7684\u4E00\u8655\u7926\u93AE\u7A0D\u4F5C\u4F11\u6574\uFF0C\u672C\u4F86\u53EA\u662F\u70BA\u4E86\u88DC\u5145\u7269\u8CC7\uFF0C\u6C92\u60F3\u5230\u7576\u591C\u5C31\u906D\u9047\u4E86\u5929\u4F7F\u8972\u64CA\u3002\u5929\u6C23\u7A81\u7136\u8B8A\u5F97\u5341\u5206\u60E1\u52A3\uFF0C\u74B0\u5854\u5546\u6703\u7684\u4F01\u696D\u4FDD\u5168\u4EBA\u54E1\u5F88\u96E3\u5373\u523B\u62B5\u9054\uFF0C\u6211\u8207\u93AE\u4E0A\u5C45\u6C11\u53EA\u80FD\u5404\u81EA\u8EB2\u85CF\uFF0C\u4EE5\u6C42\u81EA\u4FDD\u3002\n\u90A3\u5929\u665A\u4E0A\uFF0C\u6211\u85CF\u8EAB\u5728\u7926\u93AE\u908A\u7DE3\u4E00\u8655\u5EE2\u68C4\u5EE0\u623F\u7684\u9AD8\u8655\uFF0C\u6B63\u56E0\u5982\u6B64\uFF0C\u624D\u76EE\u7779\u4E86\u4E4B\u5F8C\u767C\u751F\u7684\u4E00\u5207\u3002\n\u6709\u4E09\u500B\u4EBA\uFF0C\u81EA\u93AE\u5916\u90A3\u7247\u4E0D\u77E5\u4F55\u6642\u51FA\u73FE\u7684\u4FB5\u8755\u4E2D\u8D70\u4F86\u3002\u4ED6\u5011\u4F7F\u7528\u8457\u6211\u5F9E\u672A\u898B\u904E\u7684\u88DD\u5099\uFF0C\u770B\u4F3C\u539A\u91CD\uFF0C\u884C\u52D5\u537B\u7570\u5E38\u4FD0\u843D\u3002\u9ED1\u6697\u4E4B\u4E2D\uFF0C\u6642\u800C\u6709\u5FAE\u5149\u4EAE\u8D77\uFF0C\u4F34\u96A8\u8457\u4F4E\u6C89\u8072\u97FF\uFF0C\u7336\u5982\u88C2\u7378\u5636\u9CF4\u2014\u2014\u6211\u7121\u6CD5\u78BA\u5207\u5F62\u5BB9\u90A3\u662F\u4EC0\u9EBC\uFF0C\u53EA\u77E5\u9053\u4ED6\u5011\u4F7F\u7528\u7684\u7D55\u975E\u5E38\u898B\u4E4B\u7269\u3002\u4E09\u4EBA\u5206\u6563\u884C\u52D5\uFF0C\u5176\u4E2D\u4E00\u4EBA\u5728\u5929\u4F7F\u7FA4\u4E2D\u885D\u6BBA\uFF0C\u53E6\u5916\u5169\u4EBA\u5247\u53EA\u662F\u7AD9\u5728\u9AD8\u8655\uFF0C\u4E0D\u6642\u51FA\u624B\u89E3\u6C7A\u6389\u610F\u5916\u904A\u8569\u81F3\u93AE\u6C11\u9644\u8FD1\u7684\u5929\u4F7F\u3002\u4E09\u4EBA\u9ED8\u5951\u975E\u5E38\uFF0C\u5F77\u5F7F\u5728\u57F7\u884C\u4E00\u4EF6\u65E9\u5DF2\u91CD\u8907\u904E\u7121\u6578\u904D\u7684\u4EFB\u52D9\u3002\u6211\u884C\u5546\u591A\u5E74\uFF0C\u898B\u904E\u4E0D\u5C11\u5DE5\u4EBA\u885B\u968A\uFF0C\u6216\u662F\u4F01\u696D\u5B89\u5168\u4EBA\u54E1\u6230\u9B25\u7684\u5834\u9762\uFF0C\u800C\u90A3\u4E00\u591C\u7684\u666F\u8C61\u2014\u2014\u7279\u5225\u662F\u5728\u5929\u4F7F\u7FA4\u4E2D\u885D\u6BBA\u7684\u90A3\u4E00\u4F4D\uFF0C\u6211\u5F9E\u672A\u898B\u904E\u9019\u822C\u8EAB\u624B\uFF0C\u5C31\u50CF\u662F\u708E\u570B\u53E4\u8A71\u88E1\u8AAA\u7684\u300C\u4E00\u4EBA\u6210\u8ECD\u300D\u90A3\u6A23\u2014\u2014\u81F3\u4ECA\u4ECD\u6E05\u6670\u5730\u70D9\u5370\u5728\u6211\u7684\u8166\u6D77\u4E4B\u4E2D\u3002\n\u96D6\u7136\u5929\u4F7F\u5F15\u767C\u7684\u9A37\u4E82\u5F88\u5FEB\u88AB\u4ED6\u5011\u5E73\u606F\uFF0C\u4F46\u6211\u5011\u4E00\u76F4\u8EB2\u85CF\u81F3\u5929\u660E\uFF0C\u76F4\u5230\u5E7E\u540D\u81BD\u5927\u7684\u93AE\u6C11\u7387\u5148\u51FA\u53BB\u63A2\u67E5\uFF0C\u624D\u6562\u8D70\u51FA\u5404\u81EA\u7684\u85CF\u8EAB\u8655\u3002\u5371\u96AA\u6D88\u5931\u4E86\uFF0C\u53EA\u7559\u4E0B\u6EFF\u5730\u788E\u77F3\uFF0C\u90A3\u4E09\u4EBA\u4E5F\u4E0D\u898B\u4E86\u8E64\u5F71\u3002\u5118\u7BA1\u4E0D\u77E5\u9053\u4ED6\u5011\u7684\u59D3\u540D\uFF0C\u4F46\u6211\u78BA\u4FE1\uFF0C\u4ED6\u5011\u4E26\u975E\u7576\u5730\u5C45\u6C11\uFF0C\u4E5F\u975E\u93AE\u6C11\u5011\u6240\u731C\u6E2C\u7684\u85A9\u5361\u8332\u50F