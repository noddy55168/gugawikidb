  "lore": "\u9019\u57CE\u88E1\u6709\u8A31\u591A\u5BB6\u65CF\u3002\u63D0\u5230\u6700\u548C\u7766\u7F8E\u597D\u7684\uFF0C\u5927\u5BB6\u4E00\u6642\u9593\u9084\u771F\u60F3\u4E0D\u51FA\u4F86\uFF0C\u4F46\u8981\u662F\u8AAA\u8D77\u6700\u4E0D\u548C\u7766\u7684\uFF0C\u4E00\u5B9A\u662F\u97CB\u4F2F\u5BB6\u3002\u5F88\u5C11\u6709\u4E00\u500B\u5BB6\u5EAD\uFF0C\u5728\u6709\u5982\u6B64\u591A\u5B69\u5B50\u7684\u540C\u6642\uFF0C\u53C8\u6709\u5982\u6B64\u591A\u7684\u5ACC\u9699\uFF0C\u6BCF\u516D\u5341\u56DB\u5E73\u65B9\u516C\u91CC\u7684\u571F\u5730\u4E0A\uFF0C\u53EA\u80FD\u6709\u4E00\u500B\u97CB\u4F2F\u5BB6\u7684\u5B69\u5B50\uFF0C\u4E0D\u7136\u4FBF\u6703\u6709\u66B4\u529B\u7684\u6D41\u8840\u4E8B\u4EF6\u964D\u81E8\u9019\u7247\u4E0D\u5E78\u7684\u571F\u5730\u3002\n\u4E0A\u500B\u6708\uFF0C\u97CB\u4F2F\u5BB6\u6700\u5E74\u9577\u7684\u5B69\u5B50\u5728\u6230\u5834\u4E0A\u63A5\u5230\u4E00\u5C01\u4FE1\uFF0C\u6BBA\u6B7B\u773C\u524D\u7684\u6575\u4EBA\u5F8C\uFF0C\u4ED6\u627E\u4E86\u9577\u5B98\uFF0C\u8ACB\u4E86\u4E00\u500B\u6708\u7684\u5047\uFF0C\u8E0F\u4E0A\u4E86\u8FD4\u57CE\u7684\u65C5\u9014\u3002\u4ED6\u8D70\u904E\u6797\u5730\uFF0C\u9047\u5230\u81EA\u5DF1\u7684\u5F1F\u5F1F\uFF0C\u5728\u65A7\u982D\u7838\u5230\u81C9\u4E4B\u524D\uFF0C\u4ED6\u5C07\u4FE1\u88E1\u7684\u5167\u5BB9\u8AAA\u4E86\u51FA\u4F86\u3002\u4ED6\u7684\u5F1F\u5F1F\u96A8\u5373\u5C07\u65A7\u5B50\u4E1F\u4E0B\uFF0C\u8349\u8349\u6536\u4E86\u5E7E\u6A23\u6771\u897F\uFF0C\u4FBF\u4E00\u540C\u8E0F\u4E0A\u9577\u8DEF\u3002\n\u6CB3\u6D41\u7684\u5CB8\u908A\uFF0C\u4ED6\u5011\u7684\u59B9\u59B9\u5DF2\u7D93\u65E9\u65E9\u4E58\u8239\u7B49\u5019\uFF0C\u5979\u624B\u88E1\u5DE8\u5927\u7684\u8239\u69F3\u8B93\u4ED6\u5011\u4E0D\u5F97\u4E0D\u4E00\u8DEF\u63D0\u9632\uFF0C\u4E0A\u4E00\u6B21\u4ED6\u5011\u5728\u5979\u9762\u524D\u653E\u9B06\u8B66\u60D5\uFF0C\u9192\u904E\u4F86\u5C31\u662F\u4E09\u5929\u5F8C\u4E86\u3002\n\u4ED6\u5011\u5269\u4E0B\u7684\u6642\u9593\u4E0D\u591A\uFF0C\u4F46\u4ED6\u5011\u5269\u4E0B\u7684\u65C5\u9014\u9084\u5F88\u9577\u3002\n\u524D\u65B9\u9084\